# Supabase project credentials (Project Settings -> API in the Supabase
# dashboard). Both auth (GitHub OAuth + email/password) and project save/load
# stay hidden in the UI until BOTH are set -- see lib/supabase.ts.
#
# Copy this file to .env.local (gitignored) and fill in your project's values.
# The anon key is safe to ship to the browser -- Row Level Security (see
# supabase/migrations/0001_projects.sql) is what actually restricts access,
# never this key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
